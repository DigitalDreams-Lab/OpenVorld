{
  "name": "openvorld",
  "version": "0.15.0",
  "description": "An open-source harness for AI agents. Every project is a vorld: a shared project folder, a crew of agents with their own workbenches, and the parties they work in together. Shown as a pixel-art world.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node engine/dev.mjs",
    "build": "vite build --config engine/client/vite.config.mjs",
    "start": "node engine/server/index.mjs",
    "ov": "node tools/ov.mjs",
    "bump": "node tools/bump-version.mjs",
    "validate": "node tools/ov.mjs validate",
    "typecheck": "tsc -p engine/client/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && node desktop/make-icons.mjs && node desktop/launch.mjs",
    "desktop:pack": "npm run build && node desktop/make-icons.mjs && electron-builder --dir",
    "desktop:dist": "npm run build && node desktop/make-icons.mjs && electron-builder",
    "desktop:release": "node tools/desktop-build.mjs --distribution",
    "desktop:install": "npm run desktop:pack && node desktop/install-mac.mjs",
    "screenshots": "npm run build && node desktop/make-icons.mjs && node desktop/screenshots.mjs",
    "demo:build": "node tools/demo-build.mjs",
    "demo": "node tools/demo-build.mjs && vite preview --config engine/client/vite.demo.config.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/tiny5": "5.3.0",
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.11",
    "phaser": "4.2.1",
    "playwright-core": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "keywords": [
    "ai-agents",
    "agent-harness",
    "workflows",
    "claude-code",
    "codex",
    "antigravity",
    "opencode",
    "gamification",
    "phaser"
  ],
  "main": "desktop/main.mjs"
}
